# Required for live email delivery (Resend verified sending domain)
RESEND_API_KEY=
FORM_FROM_EMAIL=Neverland ELC <forms@your-verified-domain.com>
FORM_INBOX_EMAIL=
# Cloudflare Turnstile site key is public; secret key stays server-side
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis REST rate limits (required for live production submissions)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional GA4; loaded only after user opts in
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Public website contact placeholders
NEXT_PUBLIC_CONTACT_PHONE=+880 [PHONE]
NEXT_PUBLIC_CONTACT_EMAIL=hello@[DOMAIN]
# Admin CMS (demo defaults are used if unset: admin / demo1234). Change before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo1234
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Set to true when serving the admin over HTTPS
COOKIE_SECURE=false
