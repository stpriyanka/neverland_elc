# Required for live email delivery (Resend verified sending domain)
RESEND_API_KEY=
FORM_FROM_EMAIL=Neverland ELC <forms@your-verified-domain.com>
FORM_INBOX_EMAIL=
# Google reCAPTCHA v3 (site key is public; secret key stays server-side)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Axiom activity log (optional; form outcomes only, no personal data)
AXIOM_TOKEN=
AXIOM_DATASET=
# Optional GA4; loaded only after user opts in
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Public website contact placeholders
NEXT_PUBLIC_CONTACT_PHONE=+8801781288659
NEXT_PUBLIC_CONTACT_EMAIL=hello@[DOMAIN]
# Admin CMS (required; login is refused if unset)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Set to true when serving the admin over HTTPS
COOKIE_SECURE=false
